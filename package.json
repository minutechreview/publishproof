{
  "name": "publishproof-prototype",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server/index.ts",
    "demo": "node --import tsx tests/demo-server.ts",
    "tinyfish:approved": "node --import tsx scripts/serve-approved-tinyfish.ts",
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:live": "node --import tsx scripts/test-live-ui.ts"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
